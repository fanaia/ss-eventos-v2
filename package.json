{
  "name": "ss-eventos-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Central SS Eventos V2 reconstruída de forma declarativa sobre o OonCore.",
  "scripts": {
    "ooncore:docs": "create-central-oon docs --sync",
    "ooncore:docs:check": "create-central-oon docs --check",
    "ooncore:conformance": "create-central-oon conformance",
    "check:manifests": "node scripts/validate-manifests.mjs",
    "baseline:check": "node scripts/check-baseline-reference.mjs",
    "check": "npm run check:manifests && npm run baseline:check && npm run ooncore:conformance",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "@oondemand/create-central-oon": "0.3.47"
  }
}
