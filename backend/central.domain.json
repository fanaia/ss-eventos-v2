{
  "name": "Central SS Eventos V2",
  "slug": "ss-eventos-v2",
  "schemaVersion": 1,
  "models": [
    {
      "name": "Pessoa",
      "singular": "pessoa",
      "basePath": "/pessoas",
      "crud": {
        "enabled": true,
        "roles": {
          "write": [
            "desenvolvedor"
          ]
        }
      },
      "fields": {
        "nome": {
          "kind": "string",
          "label": "Nome / Razão Social",
          "required": true,
          "searchable": true,
          "minLength": 2,
          "maxLength": 160
        },
        "tipo": {
          "kind": "enum",
          "label": "Tipo",
          "values": [
            "PF",
            "PJ",
            "Estrangeiro"
          ],
          "default": "PJ"
        },
        "documento": {
          "kind": "string",
          "label": "CPF / CNPJ / Documento",
          "required": true,
          "searchable": true,
          "unique": true,
          "maxLength": 32
        },
        "cliente": {
          "kind": "boolean",
          "label": "Cliente",
          "default": false
        },
        "fornecedor": {
          "kind": "boolean",
          "label": "Fornecedor",
          "default": false
        },
        "email": {
          "kind": "string",
          "label": "E-mail",
          "maxLength": 160
        },
        "telefone": {
          "kind": "string",
          "label": "Telefone",
          "maxLength": 32
        },
        "status": {
          "kind": "enum",
          "label": "Status",
          "values": [
            "Ativo",
            "Inativo"
          ],
          "default": "Ativo",
          "index": true
        }
      },
      "validations": [
        {
          "name": "pessoa-com-papel-comercial",
          "code": "PESSOA_SEM_PAPEL_COMERCIAL",
          "field": "cliente",
          "message": "Marque a pessoa como cliente, fornecedor ou ambos.",
          "assert": {
            "op": "or",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "field": "cliente"
                  },
                  {
                    "value": true
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "field": "fornecedor"
                  },
                  {
                    "value": true
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Projeto",
      "singular": "projeto",
      "basePath": "/projetos",
      "crud": {
        "enabled": true,
        "roles": {
          "write": [
            "desenvolvedor"
          ]
        }
      },
      "fields": {
        "codigo": {
          "kind": "string",
          "label": "Código",
          "required": true,
          "searchable": true,
          "unique": true,
          "maxLength": 40
        },
        "nome": {
          "kind": "string",
          "label": "Nome do projeto",
          "required": true,
          "searchable": true,
          "maxLength": 160
        },
        "cliente": {
          "kind": "ref",
          "label": "Cliente",
          "ref": "Pessoa",
          "required": true,
          "index": true
        },
        "contatoPrincipal": {
          "kind": "string",
          "label": "Contato principal",
          "maxLength": 160
        },
        "percentualFee": {
          "kind": "number",
          "label": "% Fee padrão",
          "default": 0,
          "min": 0,
          "max": 100
        },
        "percentualImposto": {
          "kind": "number",
          "label": "% Imposto padrão",
          "default": 0,
          "min": 0,
          "max": 100
        },
        "dataInicio": {
          "kind": "date",
          "label": "Data de início"
        },
        "dataFim": {
          "kind": "date",
          "label": "Data de término"
        },
        "status": {
          "kind": "enum",
          "label": "Status",
          "values": [
            "Planejamento",
            "Em andamento",
            "Concluído",
            "Cancelado"
          ],
          "default": "Planejamento",
          "index": true
        },
        "observacoes": {
          "kind": "string",
          "label": "Observações",
          "maxLength": 2000
        }
      },
      "validations": [
        {
          "name": "periodo-do-projeto-valido",
          "code": "PERIODO_PROJETO_INVALIDO",
          "field": "dataFim",
          "message": "A data de término não pode ser anterior à data de início.",
          "when": {
            "op": "and",
            "args": [
              {
                "op": "present",
                "args": [
                  {
                    "field": "dataInicio"
                  }
                ]
              },
              {
                "op": "present",
                "args": [
                  {
                    "field": "dataFim"
                  }
                ]
              }
            ]
          },
          "assert": {
            "op": "gte",
            "args": [
              {
                "field": "dataFim"
              },
              {
                "field": "dataInicio"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ProjetoItem",
      "singular": "item",
      "basePath": "/itens",
      "crud": {
        "enabled": true,
        "roles": {
          "write": [
            "desenvolvedor"
          ]
        }
      },
      "fields": {
        "projeto": {
          "kind": "ref",
          "label": "Projeto",
          "ref": "Projeto",
          "required": true,
          "index": true
        },
        "nome": {
          "kind": "string",
          "label": "Item",
          "required": true,
          "searchable": true,
          "maxLength": 180
        },
        "categoria": {
          "kind": "string",
          "label": "Categoria",
          "maxLength": 100
        },
        "subcategoria": {
          "kind": "string",
          "label": "Subcategoria",
          "maxLength": 100
        },
        "faturamento": {
          "kind": "enum",
          "label": "Faturamento",
          "values": [
            "Agência",
            "Agência Interna",
            "Faturamento Direto"
          ],
          "default": "Agência"
        },
        "estado": {
          "kind": "string",
          "label": "Estado",
          "maxLength": 2
        },
        "cidade": {
          "kind": "string",
          "label": "Cidade",
          "maxLength": 120
        },
        "tipoCusto": {
          "kind": "enum",
          "label": "Tipo de custo",
          "values": [
            "Fixo",
            "Variável"
          ],
          "default": "Variável"
        },
        "etapa": {
          "kind": "enum",
          "label": "Etapa",
          "values": [
            "Orçamento",
            "Contratação",
            "Pagamento",
            "Fechamento"
          ],
          "default": "Orçamento",
          "index": true
        },
        "quantidade": {
          "kind": "number",
          "label": "Quantidade",
          "min": 1,
          "default": 1
        },
        "diarias": {
          "kind": "number",
          "label": "Diárias",
          "min": 1,
          "default": 1
        },
        "valorUnitarioOrcamento": {
          "kind": "currency",
          "label": "Valor unitário do orçamento",
          "min": 0,
          "default": 0
        },
        "valorTotalOrcamento": {
          "kind": "currency",
          "label": "Total do orçamento",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "multiply",
              "args": [
                {
                  "field": "quantidade"
                },
                {
                  "field": "diarias"
                },
                {
                  "field": "valorUnitarioOrcamento"
                }
              ]
            }
          }
        },
        "valorUnitarioContratacao": {
          "kind": "currency",
          "label": "Valor unitário da contratação",
          "min": 0,
          "default": 0
        },
        "valorTotalContratacao": {
          "kind": "currency",
          "label": "Total da contratação",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "multiply",
              "args": [
                {
                  "field": "quantidade"
                },
                {
                  "field": "diarias"
                },
                {
                  "field": "valorUnitarioContratacao"
                }
              ]
            }
          }
        },
        "valorPagamento": {
          "kind": "currency",
          "label": "Valor do pagamento",
          "computed": {
            "precision": 2,
            "expression": {
              "field": "valorTotalContratacao"
            }
          }
        },
        "percentualFee": {
          "kind": "number",
          "label": "% Fee",
          "default": 0,
          "min": 0,
          "max": 100
        },
        "percentualImposto": {
          "kind": "number",
          "label": "% Impostos",
          "default": 0,
          "min": 0,
          "max": 100
        },
        "valorBaseFechamento": {
          "kind": "currency",
          "label": "Valor base do fechamento",
          "computed": {
            "precision": 2,
            "expression": {
              "field": "valorTotalOrcamento"
            }
          }
        },
        "valorFee": {
          "kind": "currency",
          "label": "Valor do fee",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "divide",
              "args": [
                {
                  "op": "multiply",
                  "args": [
                    {
                      "field": "valorBaseFechamento"
                    },
                    {
                      "field": "percentualFee"
                    }
                  ]
                },
                {
                  "value": 100
                }
              ]
            }
          }
        },
        "valorImpostos": {
          "kind": "currency",
          "label": "Valor dos impostos",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "divide",
              "args": [
                {
                  "op": "multiply",
                  "args": [
                    {
                      "field": "valorBaseFechamento"
                    },
                    {
                      "field": "percentualImposto"
                    }
                  ]
                },
                {
                  "value": 100
                }
              ]
            }
          }
        },
        "valorTotalFechamento": {
          "kind": "currency",
          "label": "Total do fechamento",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "add",
              "args": [
                {
                  "field": "valorBaseFechamento"
                },
                {
                  "field": "valorFee"
                },
                {
                  "field": "valorImpostos"
                }
              ]
            }
          }
        },
        "lucroValor": {
          "kind": "currency",
          "label": "Lucro",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "add",
              "args": [
                {
                  "op": "subtract",
                  "args": [
                    {
                      "field": "valorTotalOrcamento"
                    },
                    {
                      "field": "valorTotalContratacao"
                    }
                  ]
                },
                {
                  "field": "valorFee"
                }
              ]
            }
          }
        },
        "lucroPercentual": {
          "kind": "number",
          "label": "Lucro %",
          "computed": {
            "precision": 2,
            "expression": {
              "op": "divide",
              "args": [
                {
                  "op": "multiply",
                  "args": [
                    {
                      "field": "lucroValor"
                    },
                    {
                      "value": 100
                    }
                  ]
                },
                {
                  "op": "max",
                  "args": [
                    {
                      "field": "valorTotalOrcamento"
                    },
                    {
                      "value": 0.01
                    }
                  ]
                }
              ]
            }
          }
        },
        "statusIntegracao": {
          "kind": "string",
          "label": "Status da integração",
          "readonly": true,
          "default": "Não enviado"
        }
      }
    }
  ]
}
